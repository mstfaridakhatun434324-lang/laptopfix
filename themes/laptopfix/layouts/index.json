[{{ range $i, $p := where .Site.RegularPages "Section" "articles" }}{{ if $i }},{{ end }}{
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.RelPermalink | jsonify }},
  "category": {{ with $p.Params.categories }}{{ index . 0 | jsonify }}{{ else }}""{{ end }},
  "excerpt": {{ $p.Description | default ($p.Summary | plainify | truncate 140) | jsonify }}
}{{ end }}]